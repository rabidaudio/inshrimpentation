#cloud-config

hostname: shrimp
manage_etc_hosts: true

timezone: America/New_York

# Create a default user account and apply permissions
users:
  - name: pi
    groups: users,adm,dialout,audio,netdev,video,plugdev,cdrom,games,input,gpio,spi,i2c,render,sudo
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: raspberry  # Alternatively, use 'passwd:' with a hashed password for better security
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINN6Dfxdg3hz2gnzfNAKF7R+QXkTNTtOfmTlpP6Xla21 personal@empoknor.lan
    sudo: ALL=(ALL) NOPASSWD:ALL  # Allow passwordless sudo for this user

rpi:
  spi: false               # Enable SPI interface
  i2c: true                # Enable I2C interface
  serial: false            # Enable serial console and UART interface
  onewire: false           # Enable 1-Wire interface
  enable_usb_gadget: false # Enable USB gadget mode

enable_ssh: true  # Enables the SSH server on first boot

# Optional: Disable SSH password authentication if using SSH keys only (recommended for security)
ssh_pwauth: false
